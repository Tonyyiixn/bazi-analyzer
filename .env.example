# Copy to .env and fill in. .env is gitignored; this file is not.

# Anthropic API key, used by the chat agent and birth-hour rectification.
ANTHROPIC_API_KEY=

# Signs and verifies JWTs. Required - the app refuses to start without it,
# rather than falling back to a constant that is public in the repo.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# SQLAlchemy connection string. Leave unset for local development, which falls
# back to the SQLite file. Deployed environments set a Postgres URL, e.g.
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Comma-separated list of origins allowed to call this API. Leave unset for
# local development, which allows the Vite dev server on localhost:5173.
CORS_ORIGINS=
